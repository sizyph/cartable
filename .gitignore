# ============================================================
# OS / IDE
# ============================================================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
# local Claude Code launch config — per-machine, don't commit
**/.claude/

# ============================================================
# Secrets and synced data (cartable CLI)
# ============================================================
# Match every .env* variant — backups, locals, etc. — except the example.
.env
.env.*
!.env.example
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/token.json
data/device_uuid
data/*.log

# ============================================================
# Python (cartable CLI + cartable-app-backend)
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
wheels/
.venv/
venv/
ENV/
.python-version

# ============================================================
# PyInstaller artefacts (app/backend)
# ============================================================
app/backend/build/
app/backend/dist/
app/backend/*.spec

# ============================================================
# Node / Vite (app/)
# ============================================================
app/node_modules/
app/dist/
app/.vite/
*.tsbuildinfo

# ============================================================
# Rust / Tauri (app/src-tauri)
# ============================================================
app/src-tauri/target/
app/src-tauri/Cargo.lock.bak
app/src-tauri/gen/

# Bundled PyInstaller binary — generated by CI/build, not committed.
app/src-tauri/binaries/cartable-app-backend*

# ============================================================
# launchd job that contains a user-specific HOME path
# ============================================================
launchd/*.local.plist

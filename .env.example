# Pronote URL — your school's Pronote page.
#  - eleve.html  → student account
#  - parent.html → parent account (auto-detected; multi-child accounts pick the first
#                  child by default, set PRONOTE_CHILD below to pick another)
# Example: https://0123456a.index-education.net/pronote/parent.html
PRONOTE_URL=

# Authentication mode: "password" or "ent"
# - password: PRONOTE_USERNAME / PRONOTE_PASSWORD log straight into Pronote
# - ent:      PRONOTE_USERNAME / PRONOTE_PASSWORD log into the ENT, which then opens Pronote.
#             Requires PRONOTE_ENT_PROVIDER (see list in `uv run cartable list-ents`).
PRONOTE_AUTH_MODE=password

PRONOTE_USERNAME=
PRONOTE_PASSWORD=

# Only needed when PRONOTE_AUTH_MODE=ent
PRONOTE_ENT_PROVIDER=

# Only needed for parent accounts with several children — exact name as Pronote shows it.
PRONOTE_CHILD=

# Where to put the SQLite DB and the rotating auth token.
# Defaults to ./data/ relative to the project root.
CARTABLE_DATA_DIR=
